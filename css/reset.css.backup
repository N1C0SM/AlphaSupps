/* ============================================
   ALPHASUPPS DESIGN SYSTEM — VARIABLES GLOBALES
   Sistema Unificado para TODA la Aplicación
============================================ */

/* ========== VARIABLES CSS GLOBALES ========== */
:root {
  /* 🎨 PALETA DE COLORES PRINCIPAL */
  --primary-gold: #e0b94d;
  --primary-gold-light: #f4c842;
  --primary-gold-dark: #d4a73d;
  --primary-gold-hover: #c4993a;

  /* 🌙 BACKGROUNDS */
  --bg-primary: #0a0a0a;
  --bg-secondary: #1a1a1a;
  --bg-panel: rgba(255, 255, 255, 0.05);
  --bg-panel-hover: rgba(255, 255, 255, 0.08);
  --bg-card: rgba(255, 255, 255, 0.03);
  --bg-input: rgba(255, 255, 255, 0.05);
  --bg-overlay: rgba(0, 0, 0, 0.7);

  /* 📝 TEXTOS */
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.9);
  --text-muted: rgba(255, 255, 255, 0.6);
  --text-light: rgba(255, 255, 255, 0.7);
  --text-dark: #000000;

  /* 🔗 BORDES Y SOMBRAS */
  --border-primary: rgba(224, 185, 77, 0.2);
  --border-hover: rgba(224, 185, 77, 0.4);
  --border-light: rgba(255, 255, 255, 0.1);
  --shadow-primary: 0 8px 25px rgba(0, 0, 0, 0.3);
  --shadow-gold: 0 0 20px rgba(224, 185, 77, 0.1);
  --shadow-hover: 0 15px 35px rgba(0, 0, 0, 0.4);
  --shadow-inner: inset 0 1px 0 rgba(255, 255, 255, 0.1);

  /* 📏 ESPACIADO Y DIMENSIONES */
  --radius: 16px;
  --radius-large: 24px;
  --radius-small: 8px;
  --border-width: 2px;
  --border-width-thin: 1px;

  /* ⏱️ TRANSICIONES */
  --transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --transition-fast: all 0.15s ease;
  --transition-slow: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);

  /* 🔤 TIPOGRAFÍA */
  --font-primary: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  --font-secondary: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'SF Mono', Monaco, 'Cascadia Code', monospace;

  /* 📏 TAMAÑOS DE TEXTO */
  --text-xs: 0.75rem;
  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.25rem;
  --text-2xl: 1.5rem;
  --text-3xl: 1.875rem;
  --text-4xl: 2.25rem;
  --text-5xl: 3rem;

  /* 📏 ESPACIAMIENTO */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --space-20: 5rem;

  /* 🎯 Z-INDEX */
  --z-dropdown: 1000;
  --z-sticky: 1020;
  --z-fixed: 1030;
  --z-modal-backdrop: 1040;
  --z-modal: 1050;
  --z-popover: 1060;
  --z-tooltip: 1070;
}

/* ========== RESET GLOBAL ========== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-primary);
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--bg-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ========== IMÁGENES ========== */
img, picture, video, canvas, svg {
  display: block;
  max-width: 100%;
  height: auto;
}

/* ========== ENLACES ========== */
a {
  color: var(--primary-gold);
  text-decoration: none;
  transition: var(--transition-fast);
}

a:hover, a:focus {
  color: var(--primary-gold-light);
  text-decoration: none;
}

/* ========== LISTAS ========== */
ul, ol {
  list-style: none;
}

/* ========== FORMULARIOS ========== */
input, button, select, optgroup, textarea {
  font-family: inherit;
  font-size: inherit;
  line-height: inherit;
  margin: 0;
}

/* ========== BOTONES ========== */
button {
  background: none;
  border: none;
  cursor: pointer;
  font-family: inherit;
}

/* ========== TABLAS ========== */
table {
  border-collapse: collapse;
  border-spacing: 0;
}

/* ========== UTILITIES ========== */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-4);
}

@media (min-width: 640px) {
  .container {
    padding: 0 var(--space-6);
  }
}

@media (min-width: 1024px) {
  .container {
    padding: 0 var(--space-8);
  }
}

/* ========== FOCUS ACCESSIBLE ========== */
:focus-visible {
  outline: 2px solid var(--primary-gold);
  outline-offset: 2px;
}

/* ========== SCROLLBAR MODERNO ========== */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-secondary);
}

::-webkit-scrollbar-thumb {
  background: var(--border-primary);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--border-hover);
}